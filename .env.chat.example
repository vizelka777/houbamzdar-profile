PORT=8080
APP_BASE_URL=https://chat.houbamzdar.cz
FRONT_ORIGIN=https://houbamzdar.cz

# Separate chat database
CHAT_DB_URL=libsql://your-chat-db.bunnydb.net
CHAT_DB_TOKEN=your-chat-db-token

# Shared identity database from the monolith
IDENTITY_DB_URL=libsql://your-main-db.bunnydb.net
IDENTITY_DB_TOKEN=your-main-db-token

# Must match the monolith bridge configuration
CHAT_TOKEN_SECRET=change_me_chat_secret
CHAT_TOKEN_ISSUER=https://api.houbamzdar.cz
CHAT_TOKEN_AUDIENCE=houbamzdar-chat

# Seeded public room
CHAT_GENERAL_ROOM_SLUG=general
CHAT_GENERAL_ROOM_TITLE=Obecný chat
